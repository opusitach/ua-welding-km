# Build context: only what the build stage needs (package*.json, src, public, scripts, design/assets, configs, nginx.conf)
.git
.gitignore
node_modules
.next
out
build
coverage
*.tsbuildinfo
next-env.d.ts
.DS_Store
npm-debug.log*

# secrets / local env
.env
.env.*

# docs and editor/agent files
*.md
.claude
.vscode
.idea

# deployment files (not needed inside the image except nginx.conf)
Dockerfile
.dockerignore
docker-compose*.yml

# design mockups: keep design/assets (source images for scripts/optimize-images.mjs)
design/*.html

# generated by prebuild inside the image
public/images
src/app/icon.png
src/app/apple-icon.png
